{
	"name": "@openfarm/mcp-marketplace",
	"version": "0.0.1",
	"private": true,
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./browser": {
			"types": "./src/browser.ts",
			"default": "./src/browser.ts"
		},
		"./types": "./src/types.ts",
		"./catalog": "./catalog.json"
	},
	"scripts": {
		"lint": "bunx biome check .",
		"type-check": "bunx tsc -p tsconfig.json --noEmit",
