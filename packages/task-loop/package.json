{
  "name": "@openfarm/task-loop",
  "version": "0.0.1",
  "description": "OpenFarm Task Loop - Autonomous task execution loop inspired by Ralph TUI",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "task-loop": "./bin/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./orchestrator": "./src/orchestrator.ts"
  },
  "scripts": {
    "lint": "bunx biome check .",
    "type-check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bunx vitest run --passWithNoTests",
    "clean": "rm -rf dist build .turbo"
  },
  "dependencies": {
    "@openfarm/core": "workspace:*",
    "@openfarm/workflow-engine": "workspace:*",
    "@openfarm/workflow-executor": "workspace:*",
    "@openfarm/agent-runner": "workspace:*",
    "@openfarm/git-worktree": "workspace:*",
    "@openfarm/result": "workspace:*",
    "@openfarm/logger": "workspace:*",
    "@openfarm/types": "workspace:*",
    "@openfarm/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "task-loop",
    "orchestration",
    "ai-agent",
    "autonomous",
    "ralph"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/openfarm/openfarm.git",
    "directory": "packages/task-loop"
  }
}
