{
  "name": "@openfarm/web-ui",
  "version": "0.1.0",
  "description": "Web UI components for OpenFarm",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "bunx biome check .",
    "lint:fix": "bunx biome check . --write",
    "clean": "rm -rf dist node_modules",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "node-pty": "0.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
