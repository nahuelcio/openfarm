{
	"name": "@openfarm/plan-review",
	"version": "0.1.0",
	"description": "Interactive plan review and annotation system for OpenFarm agents",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types/index.ts",
		"./ui": "./src/ui/index.ts",
		"./annotations": "./src/annotations/index.ts"
	},
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"type-check": "tsc --noEmit",
		"plan-openfarm": "bun ./bin/plan-openfarm"
	},
	"dependencies": {
		"@openfarm/types": "workspace:*",
		"@openfarm/core": "workspace:*",
		"@openfarm/result": "workspace:*",
		"@openfarm/logger": "workspace:*",
		"@openfarm/utils": "workspace:*",
		"better-sqlite3": "^12.6.2",
		"uuid": "^11.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
				"@types/uuid": "^10.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
