{
  "name": "@openfarm/plan-review",
  "version": "0.1.0",
  "description": "Interactive plan review and annotation system for OpenFarm agents",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./ui": "./src/ui/index.ts",
    "./annotations": "./src/annotations/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "bunx tsup",
    "dev": "bunx tsup --watch",
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "clean": "rm -rf dist node_modules",
    "test": "bunx vitest run --passWithNoTests"
  },
  "dependencies": {
    "@openfarm/types": "workspace:*",
    "@openfarm/core": "workspace:*",
    "@openfarm/result": "workspace:*",
    "@openfarm/logger": "workspace:*",
    "@openfarm/utils": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
