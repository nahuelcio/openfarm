{
	"name": "@openfarm/provider-opencode",
	"version": "0.1.0",
	"description": "OpenCode provider for OpenFarm - CLI-based coding agent with OpenCode server",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"test": "vitest --run --passWithNoTests",
		"test:run": "vitest --run --passWithNoTests",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check . --fix"
	},
	"keywords": [
		"openfarm",
		"provider",
		"opencode",
		"ai",
		"coding"
	],
	"author": "OpenFarm Team",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/openfarm-ai/openfarm.git",
		"directory": "packages/provider-opencode"
	},
	"dependencies": {
		"@openfarm/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.6.0",
		"vitest": "^2.0.0"
	},
	"peerDependencies": {
		"@openfarm/sdk": "workspace:*"
	}
}
