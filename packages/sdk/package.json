{
	"name": "@openfarm/sdk",
	"version": "0.0.1",
	"description": "OpenFarm SDK - AI-powered code editing for your applications",
	"license": "MIT",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.mjs",
			"require": "./dist/runtime/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"openfarm": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"prepublishOnly": "bun run build",
		"lint": "bunx biome check .",
		"type-check": "bunx tsc -p tsconfig.json --noEmit",
		"test": "bunx vitest run",
		"clean": "del /s /q dist build .turbo 2>nul || echo Clean complete",
		"dev": "bun run src/cli.ts"
	},
	"dependencies": {
		"@openfarm/core": "workspace:*",
		"@openfarm/git": "workspace:*",
		"@openfarm/mcp-marketplace": "workspace:*",
		"@openfarm/memory-system": "workspace:*",
		"ai": "^6.0.85",
		"better-sqlite3": "^12.6.2",
		"chalk": "5.6.2",
		"js-yaml": "^4.1.1",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"uuid": "^13.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^25.2.3",
		"@types/uuid": "^11.0.0",
		"fast-check": "^4.5.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"ai",
		"code-editing",
		"sdk",
		"anthropic",
		"openai",
		"claude-code"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/openfarm/openfarm.git",
		"directory": "packages/sdk"
	},
	"bugs": {
		"url": "https://github.com/openfarm/openfarm/issues"
	},
	"homepage": "https://github.com/openfarm/openfarm#readme",
	"publishConfig": {
		"access": "public"
	}
}
