{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": false,
		"sourceMap": true,
		"outDir": "./dist",
		"noEmit": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"importHelpers": false,
		"baseUrl": ".",
		"paths": {
			"@openfarm/core/*": ["../core/src/*"],
			"@openfarm/git-worktree": ["../git-worktree/src/index.ts"],
			"@openfarm/tui-opentui": ["./src/tui/opentui/index.ts"],
			"@openfarm/tui-opentui/spinner": ["./src/tui/opentui/spinner.tsx"],
			"@openfarm/tui-opentui/text-input": ["./src/tui/opentui/text-input.tsx"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
