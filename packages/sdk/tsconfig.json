{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@openfarm/tui-opentui": ["./src/tui/opentui/index.ts"],
      "@openfarm/tui-opentui/spinner": ["./src/tui/opentui/spinner.tsx"],
      "@openfarm/tui-opentui/text-input": ["./src/tui/opentui/text-input.tsx"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
