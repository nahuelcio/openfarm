{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDirs": ["./src", "../*/src"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@openfarm/*": ["../*/src/index.ts"]
		},
		"types": ["node"]
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules", "**/*.test.ts"]
}
