{
  "name": "@openfarm/remote-server",
  "version": "0.0.1",
  "description": "OpenFarm Remote Server - WebSocket server for remote instance management",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "bunx biome check .",
    "type-check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bunx vitest run --passWithNoTests",
    "clean": "rm -rf dist build .turbo"
  },
  "dependencies": {
    "@openfarm/core": "workspace:*",
    "@openfarm/git-worktree": "workspace:*",
    "@openfarm/logger": "workspace:*",
    "@openfarm/task-loop": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "remote",
    "websocket",
    "server",
    "multi-instance"
  ],
  "private": true
}
