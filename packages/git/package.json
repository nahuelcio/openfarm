{
	"name": "@openfarm/git",
	"version": "0.0.1",
	"description": "OpenFarm Git Operations - Unified Git CLI operations with worktree and diff support",
	"license": "MIT",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types.ts",
		"./types/*": "./src/types/*.ts",
		"./operations": "./src/operations.ts",
		"./worktree": "./src/worktree.ts",
		"./diff": "./src/diff/index.ts"
	},
	"scripts": {
		"lint": "bunx biome check .",
		"type-check": "bunx tsc -p tsconfig.json --noEmit",
		"test": "bunx vitest run",
		"clean": "rm -rf dist build .turbo"
	},
	"dependencies": {
		"@openfarm/core": "workspace:*",
		"@openfarm/result": "workspace:*",
		"@openfarm/logger": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^25.0.0",
		"typescript": "^5.6.0",
		"vitest": "^4.0.17"
	},
	"keywords": [
		"git",
		"worktree",
		"diff",
		"version-control",
		"openfarm",
		"cli"
	],
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/openfarm/openfarm.git",
		"directory": "packages/git"
	}
}
