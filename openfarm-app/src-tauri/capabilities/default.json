{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:allow-execute",
    "shell:allow-open"
  ],
  "shell": {
    "scope": {
      "code": {
        "name": "code",
        "cmd": "code",
        "args": true
      },
      "git": {
        "name": "git",
        "cmd": "git",
        "args": true
      },
      "open": {
        "name": "open",
        "cmd": "open",
        "args": true
      }
    }
  }
}
